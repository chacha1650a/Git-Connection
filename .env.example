# .env.example — 값이 없는 예시 파일 (이 파일만 깃에 올린다)
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 .gitignore 로 제외되어 있으므로 절대 커밋되지 않는다.

# --- 게시판 DB (과제 4) ---
# 예: mysql+pymysql://<사용자>:<비밀번호>@localhost:3306/my_new_board_db
DATABASE_URL=

# --- 보안 이벤트 수집 API 키 (n8n 이 X-API-Key 헤더로 보낸다) ---
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURITY_API_KEY=

# --- JWT 서명 키 ---
JWT_SECRET_KEY=

# --- 공공데이터 API (기존 기능) ---
PUBLIC_API_KEY=
PUBLIC_API_URL=

# --- n8n Webhook (alert_sender.py 가 사용) ---
# n8n 워크플로우의 Production URL. 예: http://localhost:5678/webhook/login-alert
N8N_WEBHOOK_URL=
